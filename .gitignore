# ==========================================
# Python Virtual Environments
# ==========================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
deepface-env/
*/.venv/
*/venv/
*/env/

# ==========================================
# Python Cache & Bytecode
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
coverage/
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ==========================================
# Frontend & Node Dependencies
# ==========================================
node_modules/
*/node_modules/
.vite/
.eslintcache
*.tsbuildinfo
frontend/dist/
frontend/dist-ssr/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ==========================================
# Logs & Temporary Files
# ==========================================
*.log
logs/
*.tmp
*.temp

# ==========================================
# Project Data & Generated Outputs
# ==========================================
data/*
!data/.gitkeep
outputs/*
!outputs/.gitkeep

# ==========================================
# IDE & Operating System Files
# ==========================================
.vscode/
.idea/
.DS_Store
*.swp
*.swo
Thumbs.db
